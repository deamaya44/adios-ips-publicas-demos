KUBE_CONTEXT=orbstack                       # contexto de kubectl y helm donde corren las demos (kubectl config get-contexts)

DEMO_HOSTNAME=demo.tu-dominio.com           # demo 1: nombre público de la app; dominio elegido en cloudflared tunnel login

NB_PAT=                                     # demo 2: access token de NetBird (nbp_...), lo usa Terraform
INTERNAL_DOMAIN=interno.tu-dominio.com      # demo 2: zona DNS privada de NetBird; no existe en internet
POSTGRES_PASSWORD=                          # demo 2: contraseña del usuario app de Postgres
CERT_MANAGER_CLOUDFLARE_TOKEN=              # extra: token de Cloudflare para cert-manager (DNS Edit + SSL and Certificates Edit)
LE_ISSUER=letsencrypt-staging               # extra caso B: letsencrypt-staging para probar, letsencrypt para el certificado válido
PGADMIN_PASSWORD=                           # extra caso B: clave de pgAdmin (usuario lector@adios-ips.com, solo lectura)
EXTRA_HOSTNAME=                             # extra caso A, opcional: nombre público propio; vacío = extra.<dominio de DEMO_HOSTNAME>

AUTO_APPROVE=0                              # 1 = terraform apply sin pedir confirmación
