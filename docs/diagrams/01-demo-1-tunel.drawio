groundColor=none;" vertex="1" parent="1"><mxGeometry x="915" y="639" width="26" height="26" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Gateway entrada (NGINX Gateway Fabric)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Listener http :80. Service entrada-nginx ClusterIP: sin IP externa. Un solo punto de entrada para todas las apps.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#009639;" vertex="1" parent="1"><mxGeometry x="930" y="690" width="680" height="75" as="geometry"/></mxCell><mxCell id="c38" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="942" y="711.5" width="32" height="32" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Opción A · conector-rapido (k8s/tunel/02-rapido.yaml)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Sin cuenta ni dominio: cloudflared --url crea una URL temporal *.trycloudflare.com directo a whoami.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#9AA0A6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="905" y="800" width="730" height="80" as="geometry"/></mxCell><mxCell id="c40" value="" style="fontFamily=Helvetica;aspect=fixed;sketch=0;html=1;dashed=0;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#326CE5;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;prIcon=pod;fontSize=11;fontColor=#333333;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="917" y="824.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;✕ Ningún puerto de entrada.&lt;/b&gt;&lt;br&gt;Lo único que cruza el borde del cluster es la conexión saliente del conector hacia Cloudflare (QUIC o HTTP/2, puerto 7844). Si el conector se apaga, la app deja de existir para internet." style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#C5221F;" vertex="1" parent="1"><mxGeometry x="905" y="895" width="730" height="95" as="geometry"/></mxCell><mxCell id="c42" value="1 · resuelve" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#80868B;fontSize=11;fontColor=#80868B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="2 · HTTPS 443" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E8710A;fontSize=11;fontColor=#E8710A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="3 · por el túnel" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E8710A;fontSize=11;fontColor=#E8710A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="conexión saliente&lt;br&gt;QUIC / HTTP2 :7844" style="fontFamily=Helvetica;edgeS