<mxfile host="Electron" version="32.4.1"><diagram id="01-demo-1-tunel" name="01-demo-1-tunel"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1030" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Demo 1 · Publicar una app sin abrir puertos (Cloudflare Tunnel)&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="30" as="geometry"/></mxCell><mxCell id="c2" value="El conector abre la conexión desde adentro hacia el borde de Cloudflare y entrega todo a un Gateway interno (NGINX Gateway Fabric) que enruta por hostname. Sin LoadBalancer, NodePort ni reglas de entrada." style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1620" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Internet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Cualquier navegador&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=44;spacingTop=6;fontSize=13;fontColor=#202124;fillColor=#F8F9FA;strokeColor=#9AA0A6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="290" height="200" as="geometry"/></mxCell><mxCell id="c4" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="119" width="26" height="26" as="geometry"/>