<mxfile host="Electron" version="32.4.1"><diagram id="02-demo-2-malla" name="02-demo-2-malla"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1060" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Demo 2 · Llegar a una base de datos privada sin bastión (NetBird)&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="30" as="geometry"/></mxCell><mxCell id="c2" value="La laptop entra a una malla WireGuard. Del cluster solo se publican dos IPs /32 con dos políticas (UDP 53 y TCP 5432). El nombre bd.interno.tu-dominio.com no existe en internet." style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1620" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Tu laptop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Perfil NetBird adios-ips&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=44;spacingTop=6;fontSize=13;fontColor=#202124;fillColor=#F8F9FA;strokeColor=#9AA0A6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="800" as="geometry"/></mxCell><mxCell id="c4" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="119" width="26" height="26" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Cliente NetBird&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Grupo laptops. tools.sh laptop lo une con la setup key de laptops sin tocar tu perfil default.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#F68330;" vertex="1" parent="1"><mxGeometry x="60" y="175" width="290" height="120" as="geometry"/></mxCell><mxCell id="c6" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="72" y="219.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;psql -h bd.interno.tu-dominio.com&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;o postgres.demo-malla.svc.cluster.local&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#4169E1;" vertex="1" parent="1"><mxGeometry x="60" y="315" width="290" height="100" as="geometry"/></mxCell><mxCell id="c8" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="72" y="349.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;DNS público (1.1.1.1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;bd.interno.tu-dominio.com: NXDOMAIN. Solo existe dentro de la malla.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#C5221F;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="60" y="435" width="290" height="100" as="geometry"/></mxCell><mxCell id="c10" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="72" y="469.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;demo-2-malla.sh up&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;kubectl apply de k8s/malla/ y terraform apply con enable_malla=true. Necesita la base de tools.sh up.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#4EAA25;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="290" height="120" as="geometry"/></mxCell><mxCell id="c12" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="72" y="644.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;terraform/ (OpenTofu)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;locals.tf define todo; main.tf solo pasa each.value a los módulos netbird/*. Un solo state.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#E7B000;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="290" height="150" as="geometry"/></mxCell><mxCell id="c14" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="72" y="799.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;NetBird (api.netbird.io)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Plano de control: reparte llaves y reglas, no transporta datos&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=44;spacingTop=6;fontSize=13;fontColor=#202124;fillColor=#FFF4EC;strokeColor=#F68330;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="560" height="570" as="geometry"/></mxCell><mxCell id="c16" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="460" y="119" width="26" height="26" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Management + Signal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Ambos peers se conectan hacia afuera. Aquí no entra nada al cluster.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#F68330;" vertex="1" parent="1"><mxGeometry x="470" y="180" width="520" height="80" as="geometry"/></mxCell><mxCell id="c18" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="482" y="204.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Grupos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Base (tools.sh): k8s-routers, laptops y sus setup keys.&lt;br&gt;Demo 2: k8s-dns y k8s-bd.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#F68330;" vertex="1" parent="1"><mxGeometry x="470" y="280" width="250" height="170" as="geometry"/></mxCell><mxCell id="c20" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="482" y="349.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Network cluster-demo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Base: router k8s-routers con masquerade.&lt;br&gt;Demo 2: recursos /32 kube-dns y postgres.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#F68330;" vertex="1" parent="1"><mxGeometry x="740" y="280" width="250" height="170" as="geometry"/></mxCell><mxCell id="c22" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="752" y="349.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Políticas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;laptops → k8s-dns: UDP 53&lt;br&gt;laptops → k8s-bd: TCP 5432&lt;br&gt;Con la política Default deshabilitada, lo demás se bloquea.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#F68330;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="250" height="190" as="geometry"/></mxCell><mxCell id="c24" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="482" y="549.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;DNS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Base: zona privada interno.tu-dominio.com.&lt;br&gt;Demo 2: nameserver kube-dns para svc.cluster.local y el registro bd → IP de postgres.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#F68330;" vertex="1" parent="1"><mxGeometry x="740" y="470" width="250" height="190" as="geometry"/></mxCell><mxCell id="c26" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="752" y="549.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Cluster Kubernetes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Sin LoadBalancer, NodePort, Ingress ni bastión&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=44;spacingTop=6;fontSize=13;fontColor=#202124;fillColor=#F5F8FE;strokeColor=#326CE5;" vertex="1" parent="1"><mxGeometry x="1090" y="110" width="570" height="800" as="geometry"/></mxCell><mxCell id="c28" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;image=data:image/svg+xml,;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1100" y="119" width="26" height="26" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Namespace netbird&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;Base compartida: lo instala tools.sh up&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=44;spacingTop=6;fontSize=13;fontColor=#202124;fillColor=#F1F8E9;strokeColor=#7CB342;" vertex="1" parent="1"><mxGeometry x="1110" y="180" width="530" height="230" as="geometry"/></mxCell><mxCell id="c30" value="" style="fontFamily=Helvetica;aspect=fixed;sketch=0;html=1;dashed=0;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#326CE5;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;prIcon=ns;fontSize=11;fontColor=#333333;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1120" y="189" width="26" height="26" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;StatefulSet routing-peer ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;WireGuard en kernel y masquerade. Nombres estables, PDB y sin PVC porque la key es reusable.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=52;spacingRight=8;fontSize=12;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#326CE5;" vertex="1" parent="1"><mxGeometry x="1130" y="240" width="310" height="130" as="geometry"/></mxCell><mxCell id="c32" value="" style="fontFamily=Helvetica;aspect=fixed;sketch=0;html=1;dashed=0;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#326CE5;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;prIcon=pod;fontSize=11;fontColor=#333333;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1142" y="289.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Secret&lt;/b&gt;&lt;br&gt;netbird-setup-key" style="fontFamily=Helvetica;aspect=fixed;sketch=0;html=1;dashed=0;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#326CE5;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;prIcon=secret;fontSize=11;fontColor=#333333;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1520" y="255" width="44" height="44" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Namespace demo-malla&lt;/b&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=44;spacingTop=6;fontSize=13;fontColor=#202124;fillColor=#F1F8E9;strokeColor=#7CB342;" vertex="1" parent="1"><mxGeometry x="1110" y="430" width="530" height="220" as="geometry"/></mxCell><mxCell id="c35" value="" style="fontFamily=Helvetica;aspect=fixed;sketch=0;html=1;dashed=0;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#326CE5;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;prIcon=ns;fontSize=11;fontColor=#333333;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1120" y="439" width="26" height="26" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&g