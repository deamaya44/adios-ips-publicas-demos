<mxfile host="Electron" version="32.4.1"><diagram id="03-extra-certificados" name="03-extra-certificados"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1310" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Extra · HTTPS en el Gateway, público y privado (cert-manager)&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Independiente de las demos: lo suyo vive en demo-extra y lo común viene de tools.sh up. Caso A: túnel propio que entra al Gateway por HTTPS con Cloudflare Origin CA. Caso B: pgAdmin por HTTPS en la malla con Let's Encrypt." style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1620" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Caso A · Cloudflare Origin CA (extra-certificados.sh origin-ca)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6368&quot;&gt;cloudflared valida el certificado del Gateway. Ese certificado solo lo reconoce Cloudflare, no el navegador.&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=44;spacingTop=6;fontSize=13;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#F38020;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1620" height="490" as="geometry"/></mxCell><mxCell id="c4" value="" style="fontFamily=Helvetica;shape=image;html=1;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroun